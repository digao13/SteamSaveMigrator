# Auto detect text files and perform LF normalization on commit
* text=auto

# C# and .NET Source Files
*.cs text eol=crlf diff=csharp
*.xaml text eol=crlf
*.csproj text eol=crlf
*.slnx text eol=crlf
*.sln text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.iss text eol=crlf
*.ps1 text eol=crlf

# Binary Files
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.dll binary
*.exe binary
