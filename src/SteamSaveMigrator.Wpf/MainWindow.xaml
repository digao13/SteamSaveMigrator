<Window x:Class="SteamSaveMigrator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SteamSaveMigrator.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue='SteamSave Migrator v1.5.0 â€¢ Migrador, Conquistas e Conversor de Saves Steam'}"
        Height="820" Width="1220"
        MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDark}"
        Icon="Assets/app_icon.ico">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" /> <!-- CabeÃ§alho Superior Steam -->
            <RowDefinition Height="*" />  <!-- ConteÃºdo Principal -->
            <RowDefinition Height="38" /> <!-- Barra de Status Inferior -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- CABEÃ‡ALHO SUPERIOR (ESTÃ‰TICA OFICIAL STEAM: LOGO, TÃTULO E STATUS)          -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1.5" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & TÃ­tulo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="Transparent" CornerRadius="8" Width="46" Height="46" Margin="0,0,14,0" ClipToBounds="True">
                        <Image Source="Assets/app_icon.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SteamSave" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Migrator" FontSize="22" FontWeight="Light" Foreground="{StaticResource BrushAccent}" Margin="2,0,0,0" />
                            <Border Background="{StaticResource BrushAccent}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersionDisplay, FallbackValue='v1.5.0'}" FontSize="11" FontWeight="Bold" Foreground="#0A0F18" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Backup em Lote, Conquistas e RestauraÃ§Ã£o AutomÃ¡tica Transparente entre Perfis" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Feedback e Status da ConexÃ£o Steam -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Feedback de Salvamento -->
                    <TextBlock Text="{Binding SettingsSavedFeedback}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushSuccessVibrant}" VerticalAlignment="Center" Margin="0,0,14,0" />

                    <!-- BotÃ£o Salvar ConfiguraÃ§Ãµes Global -->
                    <Button Content="ðŸ’¾ Salvar ConfiguraÃ§Ãµes" Style="{StaticResource ButtonPrimaryStyle}"
                            Command="{Binding SaveSettingsCommand}" Margin="0,0,12,0" Padding="14,8" FontSize="13"
                            ToolTip="Salvar preferÃªncias atuais (pastas de backup, contas Steam/Windows e monitor) permanentemente" />

                    <!-- Badge de Status da Steam -->
                    <Border CornerRadius="14" Padding="14,6" Margin="0,0,10,0" Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                     Fill="{Binding IsSteamFound, Converter={StaticResource BoolToVisConverter}, ConverterParameter={StaticResource BrushSuccessVibrant}}" />
                            <TextBlock Text="{Binding SteamStatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Border>

                    <!-- BotÃ£o Recarregar Steam -->
                    <Button Content="ðŸ”„ Recarregar" Style="{StaticResource ButtonSecondaryStyle}"
                            Command="{Binding RefreshSteamCommand}" ToolTip="Verificar instalaÃ§Ã£o e contas da Steam novamente" Padding="14,8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- CONTEÃšDO PRINCIPAL (TAB CONTROL ESTILO STEAM)                               -->
        <!-- ========================================================================= -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent" BorderThickness="0" Margin="18,14,18,8">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="20,11" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6,6,0,0"
                                        BorderBrush="Transparent"
                                        BorderThickness="0,0,0,3"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource BrushSurfaceLight}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource BrushSurfaceCard}" />
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ===================================================================== -->
            <!-- ABA 1: JOGOS INSTALADOS & SELEÃ‡ÃƒO                                     -->
            <!-- ===================================================================== -->
            <TabItem Header="ðŸŽ®  Jogos Instalados">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Barra de AÃ§Ãµes, Filtro e SeleÃ§Ã£o em Lote -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Caixa de Busca -->
                            <Grid Grid.Column="0">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="12,8" FontSize="13.5" />
                                <TextBlock Text="ðŸ” Filtrar jogos por nome ou AppID..." FontSize="13.5"
                                           Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- BotÃµes de SeleÃ§Ã£o em Lote -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Content="â˜‘ï¸ Marcar Todos" Style="{StaticResource ButtonSecondaryStyle}"
                                        Command="{Binding SelectAllGamesCommand}" Padding="14,8" Margin="0,0,8,0" />
                                <Button Content="ðŸŽ® Apenas com Saves" Style="{StaticResource ButtonSecondaryStyle}"
                                        Command="{Binding SelectGamesWithSavesCommand}" Padding="14,8" Margin="0,0,8,0"
                                        ToolTip="Identifica e seleciona automaticamente apenas os jogos que contÃªm saves locais" />
                                <Button Content="â¬œ Desmarcar" Style="{StaticResource ButtonSecondaryStyle}"
                                        Command="{Binding DeselectAllGamesCommand}" Padding="14,8" Margin="0,0,8,0" />
                            </StackPanel>

                            <!-- Contador de SeleÃ§Ã£o -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="14,6" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding SelectedGamesCount, StringFormat='{}{0} jogo(s) selecionado(s)'}"
                                               FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                </Border>
                                <TextBlock Text="{Binding TotalGamesCount, StringFormat='(de {0} jogos)'}"
                                           VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tabela de Jogos da Biblioteca Steam -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding FilteredGames}"
                                  SelectedItem="{Binding SelectedGame}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BrushBorder}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowBackground="{StaticResource BrushSurfaceCard}"
                                  AlternatingRowBackground="{StaticResource BrushSurfaceLight}">
                            <DataGrid.Columns>
                                <!-- Checkbox de SeleÃ§Ã£o em Lote -->
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55">
                                    <DataGridCheckBoxColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Sel." FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                        </DataTemplate>
                                    </DataGridCheckBoxColumn.HeaderTemplate>
                                </DataGridCheckBoxColumn>

                                <DataGridTextColumn Header="AppID" Binding="{Binding AppId}" IsReadOnly="True" Width="105" />
                                <DataGridTextColumn Header="Nome do Jogo" Binding="{Binding Name}" IsReadOnly="True" Width="2.2*" FontWeight="Bold" />
                                <DataGridTextColumn Header="Pasta de InstalaÃ§Ã£o" Binding="{Binding InstallDir}" IsReadOnly="True" Width="2*" />
                                <DataGridTextColumn Header="Tamanho no Disco" Binding="{Binding SizeFormatted}" IsReadOnly="True" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Barra Inferior de AÃ§Ãµes -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedGame.Name, TargetNullValue='Selecione um jogo para escanear ou marque vÃ¡rios para backup em lote'}"
                                           FontSize="16.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding SelectedGamesCount, StringFormat='{}{0} jogo(s) marcados para backup em lote'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="ðŸ” Analisar Saves Deste Jogo"
                                        Style="{StaticResource ButtonSecondaryStyle}"
                                        Command="{Binding ScanGameSavesCommand}"
                                        IsEnabled="{Binding SelectedGame, Converter={StaticResource NullToVisConverter}}"
                                        Margin="0,0,10,0" Padding="16,10" FontSize="13.5"
                                        ToolTip="Escaneia as pastas de saves locais do jogo selecionado e abre a tela de backup individual" />

                                <Button Content="ðŸ“¦ Fazer Backup dos Jogos Selecionados"
                                        Style="{StaticResource ButtonPrimaryStyle}"
                                        Command="{Binding GoToBatchBackupTabCommand}"
                                        FontWeight="Bold" FontSize="14" Padding="22,11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================================================================== -->
            <!-- ABA 2: FAZER BACKUP (INDIVIDUAL OU EM LOTE)                           -->
            <!-- ===================================================================== -->
            <TabItem Header="ðŸ’¾  Fazer Backup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">

                        <!-- CARD 1: PASTA DE DESTINO DOS BACKUPS (GLOBAL E PERSISTIDA) -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ðŸ“ Pasta de Destino dos Backups" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Local padrÃ£o no computador onde os arquivos compactados (.zip) sÃ£o gravados e persistidos."
                                                   FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="ðŸ’¡ PersistÃªncia Ativa no Sistema" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccessVibrant}" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding BatchBackupOutputDir, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="10,8" FontSize="13.5" />
                                    <Button Grid.Column="1" Content="ðŸ“ Escolher Pasta..." Style="{StaticResource ButtonSecondaryStyle}"
                                            Command="{Binding BrowseBatchBackupOutputDirCommand}" Margin="8,0,0,0" ToolTip="Escolher outra pasta permanente para salvar os backups" Padding="14,8" FontSize="13" />
                                    <Button Grid.Column="2" Content="ðŸ“‚ Abrir Pasta" Style="{StaticResource ButtonSecondaryStyle}"
                                            Command="{Binding OpenBackupOutputDirCommand}" Margin="6,0,0,0" ToolTip="Abrir a pasta de backups no Windows Explorer" Padding="14,8" FontSize="13" />
                                    <Button Grid.Column="3" Content="â†º PadrÃ£o" Style="{StaticResource ButtonSecondaryStyle}"
                                            Command="{Binding ResetBackupOutputDirCommand}" Margin="6,0,0,0" ToolTip="Restaurar a pasta padrÃ£o (SteamSavesBackup na raiz do usuÃ¡rio)" Padding="12,8" FontSize="13" />
                                    <Button Grid.Column="4" Content="ðŸ’¾ Salvar ConfiguraÃ§Ãµes" Style="{StaticResource ButtonPrimaryStyle}"
                                            Command="{Binding SaveSettingsCommand}" Margin="6,0,0,0" ToolTip="Gravar esta pasta de forma definitiva no settings.json" Padding="14,8" FontSize="13" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: BACKUP INDIVIDUAL DO JOGO SELECIONADO -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ðŸŽ® Backup Individual do Jogo" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                        <TextBlock Text="Compacta e arquiva os saves do jogo selecionado em um arquivo .zip dedicado com manifesto de restauraÃ§Ã£o."
                                                   FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="ðŸŽ® Escolher Jogo na Biblioteca" Style="{StaticResource ButtonSecondaryStyle}"
                                            Command="{Binding GoToGamesTabCommand}" Padding="12,6" FontSize="12.5" VerticalAlignment="Center" />
                                </Grid>

                                <Separator Background="{StaticResource BrushBorder}" Margin="0,14" />

                                <!-- Caso nenhum jogo esteja escaneado ainda -->
                                <Border Background="{StaticResource BrushSurfaceLight}" CornerRadius="8" Padding="16" Margin="0,0,0,10"
                                        Visibility="{Binding BackupGame, Converter={StaticResource InverseNullToVisConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="â„¹ï¸" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Nenhum jogo selecionado individualmente para backup." FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFF" />
                                            <TextBlock Text="Para fazer o backup de um Ãºnico jogo, volte na aba 'Jogos Instalados' e clique em 'ðŸ” Analisar Saves Deste Jogo'."
                                                       FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Caso haja um jogo escaneado -->
                                <StackPanel Visibility="{Binding BackupGame, Converter={StaticResource NullToVisConverter}}">
                                    <!-- InformaÃ§Ãµes do Jogo -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BackupGame.Name}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                                                <Border Background="{StaticResource BrushSurfaceLight}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding BackupGame.AppId, StringFormat='AppID: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BackupGame.TotalSaveFiles, StringFormat='{}{0} arquivo(s) de save identificados no sistema'}"
                                                       FontSize="12.5" Foreground="{StaticResource BrushSuccessVibrant}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Destino do Arquivo .zip Individual -->
                                    <TextBlock Text="Arquivo de SaÃ­da do Backup (.zip):" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding BackupZipPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="10,8" FontSize="13" />
                                        <Button Grid.Column="1" Content="ðŸ“ Alterar Destino (.zip)..." Style="{StaticResource ButtonSecondaryStyle}"
                                                Command="{Binding BrowseBackupOutputCommand}" Margin="8,0,0,0" Padding="14,8" FontSize="13"
                                                ToolTip="Escolher o nome ou local deste arquivo .zip especÃ­fico" />
                                    </Grid>

                                    <!-- Barra de Progresso Individual -->
                                    <StackPanel Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,14">
                                        <ProgressBar Value="{Binding BackupProgress}" Height="10" Foreground="{StaticResource BrushSuccessVibrant}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding BackupProgressText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                    </StackPanel>

                                    <!-- Resumo do Resultado Individual -->
                                    <Border Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushSuccessVibrant}" BorderThickness="1.5" CornerRadius="7" Padding="12,10" Margin="0,0,0,14"
                                            Visibility="{Binding BackupResultSummary, Converter={StaticResource NullToVisConverter}}">
                                        <TextBlock Text="{Binding BackupResultSummary}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushSuccessVibrant}" TextWrapping="Wrap" />
                                    </Border>

                                    <!-- OpÃ§Ã£o de envio para o Google Drive -->
                                    <CheckBox Content="â˜ï¸ Enviar cÃ³pia para o Google Drive automaticamente ao concluir"
                                              IsChecked="{Binding AutoUploadToCloudOnBackup}"
                                              Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12" />

                                    <!-- BotÃ£o Executar Backup Individual -->
                                    <Button Content="ðŸ’¾ Fazer Backup Deste Jogo Agora"
                                            Style="{StaticResource ButtonPrimaryStyle}"
                                            Command="{Binding StartBackupCommand}"
                                            FontSize="14.5" Padding="22,11" HorizontalAlignment="Left"
                                            IsEnabled="{Binding IsBackingUp, Converter={StaticResource InverseBoolConverter}}" />

                                    <!-- Expander com Locais Detectados -->
                                    <Expander Header="ðŸ“‚ Ver Pastas e Locais de Saves Detectados Deste Jogo" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,14,0,0">
                                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0" Padding="12">
                                            <ItemsControl ItemsSource="{Binding BackupLocations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource BrushSurfaceLight}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="140" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="120" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{StaticResource BrushAccent}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding LocationType}" FontSize="11.5" FontWeight="Bold" Foreground="#0A0F18" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                                    <TextBlock Text="{Binding SourcePath}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding TokenizedPath, StringFormat='Token: {0}'}" FontSize="11.5" Foreground="{StaticResource BrushWarning}" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding FileCount, StringFormat='{}{0} arquivo(s)'}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: BACKUP EM LOTE (MÃšLTIPLOS JOGOS DE UMA VEZ) -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ðŸ“¦ Backup em Lote (MÃºltiplos Jogos de Uma Vez)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                        <TextBlock Text="FaÃ§a o backup de todos os jogos selecionados com 1 clique. Cada jogo serÃ¡ empacotado individualmente com seu respectivo manifesto."
                                                   FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BrushAccent}" CornerRadius="12" Padding="14,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedGamesCount, StringFormat='{}{0} Jogos Marcados'}" FontWeight="Bold" Foreground="#0A0F18" FontSize="13" />
                                    </Border>
                                </Grid>

                                <Separator Background="{StaticResource BrushBorder}" Margin="0,14" />

                                <!-- Origem do Backup (Perfis de Captura) -->
                                <Border Background="{StaticResource BrushSurfaceLight}" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
