<Window x:Class="SteamSaveMigrator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SteamSaveMigrator.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue='SteamSave Migrator v1.3.1 • Migrador, Conquistas e Conversor de Saves Steam'}"
        Height="820" Width="1220"
        MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDark}"
        Icon="Assets/app_icon.ico">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" /> <!-- Cabeçalho Superior Steam -->
            <RowDefinition Height="*" />  <!-- Conteúdo Principal -->
            <RowDefinition Height="38" /> <!-- Barra de Status Inferior -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- CABEÇALHO SUPERIOR (ESTÉTICA OFICIAL STEAM: LOGO, TÍTULO E STATUS)          -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1.5" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & Título -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="Transparent" CornerRadius="8" Width="46" Height="46" Margin="0,0,14,0" ClipToBounds="True">
                        <Image Source="Assets/app_icon.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SteamSave" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Migrator" FontSize="22" FontWeight="Light" Foreground="{StaticResource BrushAccent}" Margin="2,0,0,0" />
                            <Border Background="{StaticResource BrushAccent}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersionDisplay, FallbackValue='v1.3.1'}" FontSize="11" FontWeight="Bold" Foreground="#0A0F18" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Backup em Lote, Conquistas e Restauração Automática Transparente entre Perfis" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Feedback e Status da Conexão Steam -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Feedback de Salvamento -->
                    <TextBlock Text="{Binding SettingsSavedFeedback}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushSuccessVibrant}" VerticalAlignment="Center" Margin="0,0,14,0" />

                    <!-- Botão Salvar Configurações Global -->
                    <Button Content="💾 Salvar Configurações" Style="{StaticResource ButtonPrimaryStyle}"
                            Command="{Binding SaveSettingsCommand}" Margin="0,0,12,0" Padding="14,8" FontSize="13"
                            ToolTip="Salvar preferências atuais (pastas de backup, contas Steam/Windows e monitor) permanentemente" />

                    <!-- Badge de Status da Steam -->
                    <Border CornerRadius="14" Padding="14,6" Margin="0,0,10,0" Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                     Fill="{Binding IsSteamFound, Converter={StaticResource BoolToVisConverter}, ConverterParameter={StaticResource BrushSuccessVibrant}}" />
                            <TextBlock Text="{Binding SteamStatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Border>

                    <!-- Botão Recarregar Steam -->
                    <Button Content="🔄 Recarregar" Style="{StaticResource ButtonSecondaryStyle}"
                            Command="{Binding RefreshSteamCommand}" ToolTip="Verificar instalação e contas da Steam novamente" Padding="14,8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- CONTEÚDO PRINCIPAL (TAB CONTROL ESTILO STEAM)                               -->
        <!-- ========================================================================= -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent" BorderThickness="0" Margin="18,14,18,8">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="20,11" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6,6,0,0"
                                        BorderBrush="Transparent"
                                        BorderThickness="0,0,0,3"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource BrushSurfaceLight}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource BrushSurfaceCard}" />
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ===================================================================== -->
            <!-- ABA 1: JOGOS INSTALADOS & SELEÇÃO                                     -->
            <!-- ===================================================================== -->
            <TabItem Header="🎮  Jogos Instalados">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Barra de Ações, Filtro e Seleção em Lote -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Caixa de Busca -->
                            <Grid Grid.Column="0">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="12,8" FontSize="13.5" />
                                <TextBlock Text="🔍 Filtrar jogos por nome ou AppID..." FontSize="13.5"
                                           Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Botões de Seleção em Lote -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Content="☑️ Marcar Todos" Style="{StaticResource ButtonSecondaryStyle}"
                                        Command="{Binding SelectAllGamesCommand}" Padding="14,8" Margin="0,0,8,0" />
                                <Button Content="🎮 Apenas com Saves" Style="{StaticResource ButtonSecondaryStyle}"
                                        Command="{Binding SelectGamesWithSavesCommand}" Padding="14,8" Margin="0,0,8,0"
                                        ToolTip="Identifica e seleciona automaticamente apenas os jogos que contêm saves locais" />
                                <Button Content="⬜ Desmarcar" Style="{StaticResource ButtonSecondaryStyle}"
                                        Command="{Binding DeselectAllGamesCommand}" Padding="14,8" Margin="0,0,8,0" />
                            </StackPanel>

                            <!-- Contador de Seleção -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="14,6" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding SelectedGamesCount, StringFormat='{}{0} jogo(s) selecionado(s)'}"
                                               FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                </Border>
                                <TextBlock Text="{Binding TotalGamesCount, StringFormat='(de {0} jogos)'}"
                                           VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tabela de Jogos da Biblioteca Steam -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding FilteredGames}"
                                  SelectedItem="{Binding SelectedGame}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BrushBorder}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowBackground="{StaticResource BrushSurfaceCard}"
                                  AlternatingRowBackground="{StaticResource BrushSurfaceLight}">
                            <DataGrid.Columns>
                                <!-- Checkbox de Seleção em Lote -->
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55">
                                    <DataGridCheckBoxColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Sel." FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                        </DataTemplate>
                                    </DataGridCheckBoxColumn.HeaderTemplate>
                                </DataGridCheckBoxColumn>

                                <DataGridTextColumn Header="AppID" Binding="{Binding AppId}" IsReadOnly="True" Width="105" />
                                <DataGridTextColumn Header="Nome do Jogo" Binding="{Binding Name}" IsReadOnly="True" Width="2.2*" FontWeight="Bold" />
                                <DataGridTextColumn Header="Pasta de Instalação" Binding="{Binding InstallDir}" IsReadOnly="True" Width="2*" />
                                <DataGridTextColumn Header="Tamanho no Disco" Binding="{Binding SizeFormatted}" IsReadOnly="True" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Barra Inferior de Ações -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedGame.Name, TargetNullValue='Selecione um jogo para escanear ou marque vários para backup em lote'}"
                                           FontSize="16.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding SelectedGamesCount, StringFormat='{}{0} jogo(s) marcados para backup em lote'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="🔍 Analisar Saves Deste Jogo"
                                        Style="{StaticResource ButtonSecondaryStyle}"
                                        Command="{Binding ScanGameSavesCommand}"
                                        IsEnabled="{Binding SelectedGame, Converter={StaticResource NullToVisConverter}}"
                                        Margin="0,0,10,0" Padding="16,10" FontSize="13.5"
                                        ToolTip="Escaneia as pastas de saves locais do jogo selecionado e abre a tela de backup individual" />

                                <Button Content="📦 Fazer Backup dos Jogos Selecionados"
                                        Style="{StaticResource ButtonPrimaryStyle}"
                                        Command="{Binding GoToBatchBackupTabCommand}"
                                        FontWeight="Bold" FontSize="14" Padding="22,11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================================================================== -->
            <!-- ABA 2: FAZER BACKUP (INDIVIDUAL OU EM LOTE)                           -->
            <!-- ===================================================================== -->
            <TabItem Header="💾  Fazer Backup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">

                        <!-- CARD 1: PASTA DE DESTINO DOS BACKUPS (GLOBAL E PERSISTIDA) -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="📁 Pasta de Destino dos Backups" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Local padrão no computador onde os arquivos compactados (.zip) são gravados e persistidos."
                                                   FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="💡 Persistência Ativa no Sistema" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccessVibrant}" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding BatchBackupOutputDir, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="10,8" FontSize="13.5" />
                                    <Button Grid.Column="1" Content="📁 Escolher Pasta..." Style="{StaticResource ButtonSecondaryStyle}"
                                            Command="{Binding BrowseBatchBackupOutputDirCommand}" Margin="8,0,0,0" ToolTip="Escolher outra pasta permanente para salvar os backups" Padding="14,8" FontSize="13" />
                                    <Button Grid.Column="2" Content="📂 Abrir Pasta" Style="{StaticResource ButtonSecondaryStyle}"
                                            Command="{Binding OpenBackupOutputDirCommand}" Margin="6,0,0,0" ToolTip="Abrir a pasta de backups no Windows Explorer" Padding="14,8" FontSize="13" />
                                    <Button Grid.Column="3" Content="↺ Padrão" Style="{StaticResource ButtonSecondaryStyle}"
                                            Command="{Binding ResetBackupOutputDirCommand}" Margin="6,0,0,0" ToolTip="Restaurar a pasta padrão (SteamSavesBackup na raiz do usuário)" Padding="12,8" FontSize="13" />
                                    <Button Grid.Column="4" Content="💾 Salvar Configurações" Style="{StaticResource ButtonPrimaryStyle}"
                                            Command="{Binding SaveSettingsCommand}" Margin="6,0,0,0" ToolTip="Gravar esta pasta de forma definitiva no settings.json" Padding="14,8" FontSize="13" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: BACKUP INDIVIDUAL DO JOGO SELECIONADO -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🎮 Backup Individual do Jogo" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                        <TextBlock Text="Compacta e arquiva os saves do jogo selecionado em um arquivo .zip dedicado com manifesto de restauração."
                                                   FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🎮 Escolher Jogo na Biblioteca" Style="{StaticResource ButtonSecondaryStyle}"
                                            Command="{Binding GoToGamesTabCommand}" Padding="12,6" FontSize="12.5" VerticalAlignment="Center" />
                                </Grid>

                                <Separator Background="{StaticResource BrushBorder}" Margin="0,14" />

                                <!-- Caso nenhum jogo esteja escaneado ainda -->
                                <Border Background="{StaticResource BrushSurfaceLight}" CornerRadius="8" Padding="16" Margin="0,0,0,10"
                                        Visibility="{Binding BackupGame, Converter={StaticResource InverseNullToVisConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ℹ️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Nenhum jogo selecionado individualmente para backup." FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFF" />
                                            <TextBlock Text="Para fazer o backup de um único jogo, volte na aba 'Jogos Instalados' e clique em '🔍 Analisar Saves Deste Jogo'."
                                                       FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Caso haja um jogo escaneado -->
                                <StackPanel Visibility="{Binding BackupGame, Converter={StaticResource NullToVisConverter}}">
                                    <!-- Informações do Jogo -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BackupGame.Name}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                                                <Border Background="{StaticResource BrushSurfaceLight}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding BackupGame.AppId, StringFormat='AppID: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BackupGame.TotalSaveFiles, StringFormat='{}{0} arquivo(s) de save identificados no sistema'}"
                                                       FontSize="12.5" Foreground="{StaticResource BrushSuccessVibrant}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Destino do Arquivo .zip Individual -->
                                    <TextBlock Text="Arquivo de Saída do Backup (.zip):" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding BackupZipPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="10,8" FontSize="13" />
                                        <Button Grid.Column="1" Content="📁 Alterar Destino (.zip)..." Style="{StaticResource ButtonSecondaryStyle}"
                                                Command="{Binding BrowseBackupOutputCommand}" Margin="8,0,0,0" Padding="14,8" FontSize="13"
                                                ToolTip="Escolher o nome ou local deste arquivo .zip específico" />
                                    </Grid>

                                    <!-- Barra de Progresso Individual -->
                                    <StackPanel Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,14">
                                        <ProgressBar Value="{Binding BackupProgress}" Height="10" Foreground="{StaticResource BrushSuccessVibrant}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding BackupProgressText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                    </StackPanel>

                                    <!-- Resumo do Resultado Individual -->
                                    <Border Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushSuccessVibrant}" BorderThickness="1.5" CornerRadius="7" Padding="12,10" Margin="0,0,0,14"
                                            Visibility="{Binding BackupResultSummary, Converter={StaticResource NullToVisConverter}}">
                                        <TextBlock Text="{Binding BackupResultSummary}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushSuccessVibrant}" TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Botão Executar Backup Individual -->
                                    <Button Content="💾 Fazer Backup Deste Jogo Agora"
                                            Style="{StaticResource ButtonPrimaryStyle}"
                                            Command="{Binding StartBackupCommand}"
                                            FontSize="14.5" Padding="22,11" HorizontalAlignment="Left"
                                            IsEnabled="{Binding IsBackingUp, Converter={StaticResource InverseBoolConverter}}" />

                                    <!-- Expander com Locais Detectados -->
                                    <Expander Header="📂 Ver Pastas e Locais de Saves Detectados Deste Jogo" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,14,0,0">
                                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0" Padding="12">
                                            <ItemsControl ItemsSource="{Binding BackupLocations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource BrushSurfaceLight}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="140" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="120" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{StaticResource BrushAccent}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding LocationType}" FontSize="11.5" FontWeight="Bold" Foreground="#0A0F18" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                                    <TextBlock Text="{Binding SourcePath}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding TokenizedPath, StringFormat='Token: {0}'}" FontSize="11.5" Foreground="{StaticResource BrushWarning}" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding FileCount, StringFormat='{}{0} arquivo(s)'}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: BACKUP EM LOTE (MÚLTIPLOS JOGOS DE UMA VEZ) -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="📦 Backup em Lote (Múltiplos Jogos de Uma Vez)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                        <TextBlock Text="Faça o backup de todos os jogos selecionados com 1 clique. Cada jogo será empacotado individualmente com seu respectivo manifesto."
                                                   FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BrushAccent}" CornerRadius="12" Padding="14,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedGamesCount, StringFormat='{}{0} Jogos Marcados'}" FontWeight="Bold" Foreground="#0A0F18" FontSize="13" />
                                    </Border>
                                </Grid>

                                <Separator Background="{StaticResource BrushBorder}" Margin="0,14" />

                                <!-- Origem do Backup (Perfis de Captura) -->
                                <Border Background="{StaticResource BrushSurfaceLight}" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                            <TextBlock Text="🎯 Origem do Backup (Perfis Selecionados para Captura)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                                            <TextBlock Text="Selecione de qual conta Steam e usuário Windows os saves e conquistas serão arquivados:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="👤 Conta Steam de Origem:" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                                <ComboBox ItemsSource="{Binding AvailableSteamAccounts}"
                                                          SelectedItem="{Binding SelectedSourceSteamAccount}"
                                                          DisplayMemberPath="DisplayName" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="💻 Usuário Windows de Origem:" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                                <ComboBox ItemsSource="{Binding AvailableWindowsProfiles}"
                                                          SelectedItem="{Binding SelectedSourceWindowsProfile}"
                                                          DisplayMemberPath="DisplayName" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Barra de Progresso do Lote -->
                                <StackPanel Visibility="{Binding IsBatchBackingUp, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,14">
                                    <ProgressBar Value="{Binding BatchOverallProgress}" Height="12" Foreground="{StaticResource BrushSuccessVibrant}" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding BatchOverallProgressText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                    <TextBlock Text="{Binding BatchCurrentGameText}" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Resumo do Lote Concluído -->
                                <Border Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushSuccessVibrant}" BorderThickness="1.5" CornerRadius="7" Padding="12,10" Margin="0,0,0,14"
                                        Visibility="{Binding BatchBackupSummary, Converter={StaticResource NullToVisConverter}}">
                                    <TextBlock Text="{Binding BatchBackupSummary}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushSuccessVibrant}" TextWrapping="Wrap" />
                                </Border>

                                <!-- Botão de Execução do Lote -->
                                <Button Content="🚀 Iniciar Backup de Todos os Jogos Marcados Agora"
                                        Style="{StaticResource ButtonPrimaryStyle}"
                                        Command="{Binding StartBatchBackupCommand}"
                                        FontSize="15" Padding="24,12" HorizontalAlignment="Left"
                                        IsEnabled="{Binding IsBatchBackingUp, Converter={StaticResource InverseBoolConverter}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================================================================== -->
            <!-- ABA 3: RESTAURAR SAVES (AUTOMÁTICO E TRANSPARENTE)                   -->
            <!-- ===================================================================== -->
            <TabItem Header="♻️  Restaurar Saves">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">

                        <!-- TABELA DE BACKUPS LOCAIS ARMAZENADOS NO COMPUTADOR -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="260" />
                                </Grid.RowDefinitions>

                                <!-- Header e Ações dos Backups Locais -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="📦 Backups Locais Armazenados no Computador" FontSize="16.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding LocalBackupsDirectoryDescription}" ToolTip="{Binding BatchBackupOutputDir}" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="580" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="⚡ Restaurar Selecionado" Style="{StaticResource ButtonPrimaryStyle}"
                                                Command="{Binding StartAutoRestoreCommand}" Margin="0,0,8,0" Padding="14,8" FontSize="13"
                                                ToolTip="Restaura o save e sincroniza as conquistas diretamente para as contas de destino" />
                                        <Button Content="📁 Alterar Pasta..." Style="{StaticResource ButtonSecondaryStyle}"
                                                Command="{Binding BrowseBatchBackupOutputDirCommand}" Margin="0,0,8,0" Padding="12,8" FontSize="13"
                                                ToolTip="Alterar a pasta de onde o aplicativo lista os backups locais" />
                                        <Button Content="📂 Abrir Pasta" Style="{StaticResource ButtonSecondaryStyle}"
                                                Command="{Binding OpenBackupOutputDirCommand}" Margin="0,0,8,0" Padding="12,8" FontSize="13"
                                                ToolTip="Abrir a pasta de backups no Windows Explorer" />
                                        <Button Content="🔄 Atualizar" Style="{StaticResource ButtonSecondaryStyle}"
                                                Command="{Binding RefreshLocalBackupsCommand}" Margin="0,0,8,0" Padding="12,8" FontSize="13"
                                                ToolTip="Atualizar lista de backups locais da pasta" />
                                        <Button Content="📁 Outro .zip..." Style="{StaticResource ButtonSecondaryStyle}"
                                                Command="{Binding BrowseRestoreZipCommand}" Margin="0,0,8,0" Padding="12,8" FontSize="13"
                                                ToolTip="Selecionar arquivo .zip de outra pasta ou pendrive" />
                                        <Button Content="📦 Vários..." Style="{StaticResource ButtonSecondaryStyle}"
                                                Command="{Binding BrowseMultipleRestoreZipsCommand}" Margin="0,0,8,0" Padding="12,8" FontSize="13"
                                                ToolTip="Selecionar múltiplos arquivos .zip para restaurar em lote" />
                                        <Button Content="🗑️ Excluir" Style="{StaticResource ButtonSecondaryStyle}"
                                                Command="{Binding DeleteSelectedLocalBackupCommand}" Padding="12,8" FontSize="13"
                                                ToolTip="Exclui o backup local selecionado do disco" />
                                    </StackPanel>
                                </Grid>

                                <!-- Barra de Busca em Tempo Real no Histórico Local -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <TextBox Text="{Binding LocalSearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13.5" />
                                    <TextBlock Text="🔍 Filtrar histórico por Nome do Jogo, AppID, Usuário Steam ou Usuário Windows..." FontSize="13.5"
                                               Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="14,0,32,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LocalSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="✕" Command="{Binding ClearLocalSearchCommand}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                            Padding="8,4" FontSize="11" ToolTip="Limpar busca">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondaryStyle}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LocalSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Tabela de Backups Locais -->
                                <Border Grid.Row="2" Background="{StaticResource BrushSurfaceLight}" CornerRadius="6" Padding="0">
                                    <DataGrid ItemsSource="{Binding FilteredLocalBackups}"
                                              SelectedItem="{Binding SelectedLocalBackup}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource BrushBorder}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              RowBackground="{StaticResource BrushSurfaceCard}"
                                              AlternatingRowBackground="{StaticResource BrushSurfaceLight}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Jogo" Binding="{Binding GameName}" Width="1.8*" FontWeight="Bold" />
                                            <DataGridTextColumn Header="AppID" Binding="{Binding AppId}" Width="85" />
                                            <DataGridTextColumn Header="👤 Usuário Steam" Binding="{Binding SourceSteamDisplay}" Width="1.3*" />
                                            <DataGridTextColumn Header="💻 Usuário Windows" Binding="{Binding SourceUserDisplay}" Width="1.2*" />
                                            <DataGridTextColumn Header="🏆 Conquistas" Binding="{Binding AchievementsDisplay}" Width="110" Foreground="{StaticResource BrushGold}" FontWeight="Bold" />
                                            <DataGridTextColumn Header="Tamanho" Binding="{Binding FormattedSize}" Width="95" />
                                            <DataGridTextColumn Header="Data do Backup" Binding="{Binding CreatedTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="125" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- PAINEL DE DESTINO DA RESTAURAÇÃO (CROSS-STEAM & CROSS-WINDOWS) -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="18" BorderBrush="{StaticResource BrushBorderAccent}" BorderThickness="1.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Cabeçalho da Migração -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Destino da Restauração Automática" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text=" (Conversão Inteligente de Perfil Steam e Windows)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="Os arquivos de save e conquistas serão convertidos e sincronizados diretamente para as contas abaixo:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="24,3,0,0" />
                                </StackPanel>

                                <!-- Contas de Destino -->
                                <Grid Grid.Row="1" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Conta Steam de Destino -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="👤" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Perfil Steam Conectado / Destino:" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding AvailableSteamAccounts}"
                                                  SelectedItem="{Binding SelectedTargetSteamAccount}"
                                                  DisplayMemberPath="DisplayName" />
                                        <TextBlock Text="Saves e conquistas serão sincronizados com este perfil Steam." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- Usuário Windows de Destino -->
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="💻" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Usuário Windows de Destino:" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding AvailableWindowsProfiles}"
                                                  SelectedItem="{Binding SelectedTargetWindowsProfile}"
                                                  DisplayMemberPath="DisplayName" />
                                        <TextBlock Text="{Binding RestoreTargetProfile, StringFormat='Pasta Perfil: {0}'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <!-- MÓDULO DE CONQUISTAS (ACHIEVEMENTS) - CARD DE DESTAQUE DOURADO -->
                                <Border Grid.Row="2" Background="{StaticResource BrushGoldBg}" CornerRadius="8" Padding="14" Margin="0,0,0,16"
                                        BorderBrush="{StaticResource BrushGoldBorder}" BorderThickness="1.5"
                                        Visibility="{Binding HasAchievementsInBackup, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🏆" FontSize="15" Margin="0,0,8,0" />
                                                <TextBlock Text="Módulo de Conquistas (Steam Achievements)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushGold}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding RestoreAchievementsSummary}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushSuccessVibrant}" Margin="24,4,0,0" />
                                            <TextBlock Text="Ao restaurar, todas as conquistas do save serão vinculadas automaticamente ao seu perfil Steam de destino!" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="24,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🏆 Sincronizar Conquistas Avulso" Style="{StaticResource ButtonSecondaryStyle}"
                                                Command="{Binding SyncAchievementsCommand}" VerticalAlignment="Center" Padding="14,8" FontSize="12.5" FontWeight="Bold"
                                                ToolTip="Sincroniza apenas as conquistas com a conta Steam sem sobrescrever os arquivos de save" />
                                    </Grid>
                                </Border>

                                <!-- Barra de Progresso da Restauração -->
                                <StackPanel Grid.Row="3" Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,14">
                                    <ProgressBar Value="{Binding RestoreProgress}" Height="10" Foreground="{StaticResource BrushSuccessVibrant}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding RestoreProgressText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushSuccessVibrant}" />
                                </StackPanel>

                                <!-- Mensagem de Conclusão -->
                                <TextBlock Grid.Row="4" Text="{Binding RestoreResultSummary}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource BrushSuccessVibrant}" Margin="0,0,0,16" TextWrapping="Wrap"
                                           Visibility="{Binding RestoreResultSummary, Converter={StaticResource NullToVisConverter}}" />

                                <!-- Botão de Restauração em 1 Clique -->
                                <Button Grid.Row="5" Content="⚡ Restaurar Automaticamente Agora (1 Clique)"
                                        Style="{StaticResource ButtonPrimaryStyle}"
                                        Command="{Binding StartAutoRestoreCommand}"
                                        FontSize="15.5" FontWeight="Bold" Padding="26,13" HorizontalAlignment="Left"
                                        IsEnabled="{Binding IsRestoring, Converter={StaticResource InverseBoolConverter}}" />
                            </Grid>
                        </Border>

                        <!-- OPÇÕES AVANÇADAS -->
                        <Expander Header="⚙️ Opções Avançadas (Personalizar caminhos e comportamento de sobrescrita)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Nome do Usuário Destino:" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding RestoreTargetUser, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Pasta do Perfil Destino:" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding RestoreTargetProfile, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <CheckBox Content="Modo Simulação (Dry-Run: testa sem gravar arquivos)"
                                                  IsChecked="{Binding RestoreDryRun}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,24,0" />
                                        <CheckBox Content="Sobrescrever arquivos existentes no destino"
                                                  IsChecked="{Binding RestoreOverwrite}" Foreground="{StaticResource BrushTextPrimary}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- RELATÓRIO DE ARQUIVOS RESTAURADOS -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding RestoreReports.Count, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="Relatório Detalhado de Arquivos Restaurados" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10" />
                                <DataGrid ItemsSource="{Binding RestoreReports}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource BrushBorder}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          RowBackground="{StaticResource BrushSurfaceCard}"
                                          AlternatingRowBackground="{StaticResource BrushSurfaceLight}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Arquivo Original (Origem)" Binding="{Binding OriginalPath}" Width="*" />
                                        <DataGridTextColumn Header="Novo Caminho no Destino" Binding="{Binding DestinationPath}" Width="*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Success}" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================================================================== -->
            <!-- ABA 4: NUVEM GOOGLE DRIVE & MONITOR DE JOGOS                          -->
            <!-- ===================================================================== -->
            <TabItem Header="☁️  Nuvem &amp; Monitor">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- PAINEL SUPERIOR: CARDS DE STATUS E CONFIGURAÇÃO -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CARD 1: GOOGLE DRIVE -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Cabeçalho do Card Nuvem -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="☁️ Nuvem Google Drive" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Sincronização remota e backup protegido de saves" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource BrushWarning}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGoogleDriveConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource BrushSuccessVibrant}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding GoogleDriveStatusText}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Ações do Google Drive -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <!-- Botão Conectar -->
                                    <Button Content="🔑 Conectar Google Drive" Style="{StaticResource ButtonPrimaryStyle}"
                                            Command="{Binding ConnectGoogleDriveCommand}" Margin="0,0,8,0" Padding="14,9" FontSize="13"
                                            Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource InverseBoolToVisConverter}}" />

                                    <!-- Botão Cancelar Tentativa -->
                                    <Button Content="❌ Cancelar Tentativa" Style="{StaticResource ButtonSecondaryStyle}"
                                            Command="{Binding CancelGoogleDriveAuthCommand}" Margin="0,0,8,0" Padding="12,8" FontSize="13"
                                            Visibility="{Binding IsCloudLoading, Converter={StaticResource BoolToVisConverter}}"
                                            ToolTip="Cancela a tentativa de conexão atual e libera o aplicativo imediatamente" />

                                    <!-- Botão Reconectar -->
                                    <Button Content="🔄 Reconectar / Autorizar" Style="{StaticResource ButtonPrimaryStyle}"
                                            Command="{Binding ReconnectGoogleDriveCommand}" Margin="0,0,8,0" Padding="14,9" FontSize="13"
                                            Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource BoolToVisConverter}}"
                                            ToolTip="Limpa a sessão antiga e abre o navegador para reautorizar com todas as permissões" />

                                    <!-- Botão Desconectar -->
                                    <Button Content="🚪 Desconectar Conta" Style="{StaticResource ButtonSecondaryStyle}"
                                            Command="{Binding DisconnectGoogleDriveCommand}" Margin="0,0,8,0" Padding="12,8" FontSize="13"
                                            Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource BoolToVisConverter}}" />

                                    <!-- Botão Atualizar Nuvem -->
                                    <Button Content="🔄 Atualizar Backups" Style="{StaticResource ButtonSecondaryStyle}"
                                            Command="{Binding RefreshCloudBackupsCommand}" Padding="12,8" FontSize="13"
                                            Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>

                                <!-- Painel Expansível: Configuração de Credenciais OAuth -->
                                <Border Grid.Row="2" Background="{StaticResource BrushSurfaceLight}" CornerRadius="8" Padding="14" Margin="0,12,0,0"
                                        BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5"
                                        Visibility="{Binding IsConfiguringCredentials, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="🛠️ Configurar Credenciais OAuth (Google Cloud Console)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                                <TextBlock Text="Para conectar sua conta, o Google exige um aplicativo com OAuth de Desktop criado no Google Cloud." FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="🌐 Abrir Google Cloud Console" Style="{StaticResource ButtonSecondaryStyle}"
                                                    Command="{Binding OpenGoogleConsoleCommand}" Padding="10,6" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Botão de Importação do credentials.json -->
                                        <Border Background="{StaticResource BrushSurfaceCard}" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="📁 Importar arquivo 'credentials.json'" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushSuccessVibrant}" />
                                                    <TextBlock Text="Baixado diretamente da página de credenciais do Google Cloud Console." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Selecionar Arquivo .JSON" Style="{StaticResource ButtonPrimaryStyle}"
                                                        Command="{Binding ImportCredentialsJsonCommand}" Padding="14,8" FontSize="12.5" />
                                            </Grid>
                                        </Border>

                                        <!-- Inserção manual de Client ID e Secret -->
                                        <Expander Header="Ou inserir Client ID e Client Secret manualmente" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="Client ID:" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding CustomClientId, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Margin="0,0,0,8" />

                                                <TextBlock Text="Client Secret:" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding CustomClientSecret, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Margin="0,0,0,10" />

                                                <Button Content="💾 Salvar Credenciais Digitadas" Style="{StaticResource ButtonSecondaryStyle}"
                                                        Command="{Binding SaveCustomCredentialsCommand}" HorizontalAlignment="Left" Padding="14,7" FontSize="12.5" />
                                            </StackPanel>
                                        </Expander>

                                        <!-- Status da configuração -->
                                        <TextBlock Text="{Binding CredentialsStatusText}" FontSize="12.5" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushAccent}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding CredentialsStatusText, Converter={StaticResource NullToVisConverter}}" />
                                    </StackPanel>
                                </Border>

                                <!-- Texto Informativo -->
                                <TextBlock Grid.Row="3" Text="Seus backups são gravados na pasta dedicada 'SteamSaveMigrator_Backups' no seu Google Drive com isolamento de escopo seguro."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- CARD 2: MONITOR DE JOGOS DA STEAM -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header Card Monitor -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="👁️ Monitor de Jogos da Steam" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Detecta quando você fecha um jogo e faz backup automático" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WatcherStatusBadge}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                    </Border>
                                </Grid>

                                <!-- Botão Ligar/Desligar e Opções -->
                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Botão Toggle Monitor -->
                                    <Button Grid.Column="0" Command="{Binding ToggleGameWatcherCommand}" Margin="0,0,14,0" Padding="16,10" FontSize="13.5" FontWeight="Bold">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimaryStyle}">
                                                <Setter Property="Content" Value="▶️ Iniciar Monitoramento" />
                                                <Setter Property="Background" Value="{StaticResource BrushSteamGreen}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGameWatcherActive}" Value="True">
                                                        <Setter Property="Content" Value="⏹️ Parar Monitoramento" />
                                                        <Setter Property="Background" Value="{StaticResource BrushError}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Opções Automáticas & Inicialização -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <CheckBox Content="🎮 Abrir a Steam ao iniciar o SteamSaveMigrator" IsChecked="{Binding OpenSteamOnStartup}" Margin="0,0,0,6" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" ToolTip="Inicia o executável da Steam automaticamente sempre que este app for aberto" />
                                        <CheckBox Content="⚡ Iniciar monitoramento automaticamente ao abrir" IsChecked="{Binding AutoStartWatcherOnLaunch}" Margin="0,0,0,6" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" ToolTip="Começa a vigiar os jogos Steam imediatamente assim que o aplicativo for aberto" />
                                        <CheckBox Content="Compactar saves locais ao fechar jogo" IsChecked="{Binding WatcherAutoBackup}" Margin="0,0,0,5" FontSize="12.5" Foreground="#FFFFFF" />
                                        <CheckBox Content="Enviar backup para Google Drive ao fechar" IsChecked="{Binding WatcherAutoUpload}" Margin="0,0,0,5" FontSize="12.5" Foreground="#FFFFFF" />
                                        <CheckBox Content="🚀 Iniciar com o Windows / Steam (oculto na bandeja)" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,5" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" ToolTip="Inicia o aplicativo em segundo plano junto com o Windows/Steam já monitorando" />
                                        <CheckBox Content="🛡️ Minimizar para a bandeja ao fechar a janela" IsChecked="{Binding MinimizeToTrayOnClose}" Margin="0,0,0,6" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" ToolTip="Ao fechar, o app continua monitorando silenciosamente nos ícones ocultos" />
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Button Content="💾 Salvar Configurações" Style="{StaticResource ButtonPrimaryStyle}"
                                                    Command="{Binding SaveSettingsCommand}" Padding="12,6" FontSize="12"
                                                    ToolTip="Salvar preferências de inicialização, monitor e pastas permanentemente" />
                                            <TextBlock Text="{Binding SettingsSavedFeedback}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushSuccessVibrant}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Último Evento Detectado -->
                                <Border Grid.Row="2" Background="{StaticResource BrushSurfaceLight}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                    <TextBlock Text="{Binding WatcherLastEventText, StringFormat='Atividade: {0}'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- PAINEL INFERIOR: TABELA DE BACKUPS NA NUVEM & HISTÓRICO DE LOGS -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>

                        <!-- COLUNA ESQUERDA: BACKUPS NO GOOGLE DRIVE -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header e Ações dos Backups na Nuvem -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="☁️ Backups Armazenados na Nuvem" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding FilteredCloudBackupsCount, StringFormat='Exibindo {0} backup(s) no Google Drive'}" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="⚡ Baixar e Restaurar Save" Style="{StaticResource ButtonPrimaryStyle}"
                                                Command="{Binding RestoreSelectedCloudBackupCommand}" Margin="0,0,8,0" Padding="14,8" FontSize="13"
                                                ToolTip="Baixa o backup do Google Drive e restaura com conversão inteligente para os perfis selecionados" />
                                        <Button Content="🗑️ Excluir" Style="{StaticResource ButtonSecondaryStyle}"
                                                Command="{Binding DeleteSelectedCloudBackupCommand}" Margin="0,0,8,0" Padding="12,8" FontSize="13"
                                                ToolTip="Exclui o backup selecionado do Google Drive" />
                                        <Button Content="🔄 Atualizar" Style="{StaticResource ButtonSecondaryStyle}"
                                                Command="{Binding RefreshCloudBackupsCommand}" Padding="12,8" FontSize="13" ToolTip="Atualizar lista de backups na nuvem" />
                                    </StackPanel>
                                </Grid>

                                <!-- Barra de Busca na Nuvem -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <TextBox Text="{Binding CloudSearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13.5" />
                                    <TextBlock Text="🔍 Filtrar histórico por Nome do Jogo, AppID, Usuário Steam ou Usuário Windows..." FontSize="13.5"
                                               Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="14,0,32,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CloudSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="✕" Command="{Binding ClearCloudSearchCommand}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                            Padding="8,4" FontSize="11" ToolTip="Limpar busca">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondaryStyle}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CloudSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Tabela de Backups na Nuvem -->
                                <Border Grid.Row="2" Background="{StaticResource BrushSurfaceLight}" CornerRadius="6" Padding="0">
                                    <DataGrid ItemsSource="{Binding FilteredCloudBackups}"
                                              SelectedItem="{Binding SelectedCloudBackup}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource BrushBorder}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              RowBackground="{StaticResource BrushSurfaceCard}"
                                              AlternatingRowBackground="{StaticResource BrushSurfaceLight}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Jogo" Binding="{Binding GameName}" Width="1.8*" FontWeight="Bold" />
                                            <DataGridTextColumn Header="AppID" Binding="{Binding AppId}" Width="85" />
                                            <DataGridTextColumn Header="👤 Usuário Steam" Binding="{Binding SourceSteamDisplay}" Width="1.3*" />
                                            <DataGridTextColumn Header="💻 Usuário Windows" Binding="{Binding SourceUserDisplay}" Width="1.2*" />
                                            <DataGridTextColumn Header="🏆 Conquistas" Binding="{Binding AchievementsDisplay}" Width="110" Foreground="{StaticResource BrushGold}" FontWeight="Bold" />
                                            <DataGridTextColumn Header="Tamanho" Binding="{Binding FormattedSize}" Width="95" />
                                            <DataGridTextColumn Header="Data de Envio" Binding="{Binding CreatedTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="125" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Painel de Destino da Restauração da Nuvem -->
                                <Border Grid.Row="3" Background="{StaticResource BrushSurfaceCard}" CornerRadius="8" Padding="16,14" Margin="0,12,0,0" BorderBrush="{StaticResource BrushBorderAccent}" BorderThickness="1.5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🎯" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Destino da Restauração Automática" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                                <TextBlock Text=" (Conversão Inteligente de Perfil Steam e Windows)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="4,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Os arquivos baixados da nuvem serão adaptados diretamente para as contas abaixo:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="24,3,0,0" />
                                        </StackPanel>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Conta Steam de Destino -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="👤" FontSize="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="Perfil Steam de Destino:" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding AvailableSteamAccounts}"
                                                          SelectedItem="{Binding SelectedTargetSteamAccount}"
                                                          DisplayMemberPath="DisplayName" />
                                            </StackPanel>

                                            <!-- Usuário Windows de Destino -->
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="💻" FontSize="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="Usuário Windows de Destino:" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding AvailableWindowsProfiles}"
                                                          SelectedItem="{Binding SelectedTargetWindowsProfile}"
                                                          DisplayMemberPath="DisplayName" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Barra de Progresso de Restauração -->
                                <StackPanel Grid.Row="4" Margin="0,12,0,0"
                                            Visibility="{Binding IsCloudRestoring, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="{Binding CloudRestoreProgressText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4" />
                                    <ProgressBar Value="{Binding CloudRestoreProgress}" Height="8" Background="{StaticResource BrushSurfaceLight}" Foreground="{StaticResource BrushSuccessVibrant}" />
                                </StackPanel>

                                <!-- Resumo do Resultado da Restauração -->
                                <Border Grid.Row="5" Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushSuccessVibrant}" BorderThickness="1.5" CornerRadius="7" Padding="12,10" Margin="0,10,0,0"
                                        Visibility="{Binding CloudResultSummary, Converter={StaticResource NullToVisConverter}}">
                                    <TextBlock Text="{Binding CloudResultSummary}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushSuccessVibrant}" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- COLUNA DIREITA: HISTÓRICO DE LOGS DO MONITOR -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header dos Logs -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Histórico do Monitor" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Limpar" Style="{StaticResource ButtonSecondaryStyle}"
                                            Command="{Binding ClearWatcherLogsCommand}" Padding="10,5" FontSize="12" />
                                </Grid>

                                <!-- Lista de Logs -->
                                <Border Grid.Row="1" Background="{StaticResource BrushBgDark}" BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1.5" CornerRadius="6" Padding="6">
                                    <ListBox ItemsSource="{Binding WatcherLogs}"
                                             Background="Transparent" BorderThickness="0" Padding="4"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                                           Margin="2,3" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Code, Courier New, monospace" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================================================================== -->
            <!-- ABA 5: STATUS DA STEAM                                                -->
            <!-- ===================================================================== -->
            <TabItem Header="🔍  Status da Steam">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <!-- Instalação da Steam -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Instalação da Steam no Computador" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Caminho da Steam:" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SteamInfo.SteamPath}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushSuccessVibrant}" Margin="0,6" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Executável (steam.exe):" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SteamInfo.SteamExe}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,6" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pasta Userdata:" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SteamInfo.UserdataDirectory}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,6" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Contas de Usuário Steam -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Contas de Usuário Steam Registradas" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14" />
                                <ItemsControl ItemsSource="{Binding SteamInfo.Accounts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BrushSurfaceLight}" CornerRadius="7" Padding="16,12" Margin="0,0,0,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding PersonaName}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            <TextBlock Text="{Binding AccountName, StringFormat=' ({0})'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="6,0,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SteamId3, StringFormat='SteamID3: {0}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding SteamId64, StringFormat='SteamID64: {0}'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{StaticResource BrushSuccessVibrant}" CornerRadius="6" Padding="10,4" Margin="0,0,8,0"
                                                                Visibility="{Binding IsActiveNow, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="🟢 Conectado Agora" FontSize="12" FontWeight="Bold" Foreground="#000000" />
                                                        </Border>
                                                        <Border Background="{StaticResource BrushAccent}" CornerRadius="6" Padding="10,4"
                                                                Visibility="{Binding MostRecent, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="Recente" FontSize="12" FontWeight="Bold" Foreground="#0A0F18" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ========================================================================= -->
        <!-- BARRA DE STATUS INFERIOR                                                  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1.5,0,0" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                <TextBlock Grid.Column="1" Text="{Binding FooterStatusDisplay, FallbackValue='SteamSaveMigrator v1.3.1 • Backup em Lote, Conquistas &amp; Restauração Automática'}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
            </Grid>
        </Border>
    </Grid>
</Window>
