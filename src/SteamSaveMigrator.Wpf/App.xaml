<Application x:Class="SteamSaveMigrator.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SteamSaveMigrator.Wpf"
             xmlns:conv="clr-namespace:SteamSaveMigrator.Wpf.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Conversores -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConverter" />
        <conv:NullToVisibilityConverter x:Key="InverseNullToVisConverter" Invert="True" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />

        <!-- ========================================================================= -->
        <!-- PALETA DE CORES INSPIRADA NA STEAM (ELEGÂNCIA, PROFUNDIDADE E CONTRASTE)    -->
        <!-- ========================================================================= -->
        <!-- Fundo oficial da Steam e camadas de superfície -->
        <SolidColorBrush x:Key="BrushBgDark" Color="#171A21" />
        <SolidColorBrush x:Key="BrushSurface" Color="#1B2838" />
        <SolidColorBrush x:Key="BrushSurfaceLight" Color="#212F43" />
        <SolidColorBrush x:Key="BrushSurfaceCard" Color="#1B2431" />
        
        <!-- Bordas sutis no padrão azul-petróleo escuro da Steam -->
        <SolidColorBrush x:Key="BrushBorder" Color="#2A3F5A" />
        <SolidColorBrush x:Key="BrushBorderLight" Color="#3A5375" />
        <SolidColorBrush x:Key="BrushBorderAccent" Color="#66C0F4" />

        <!-- Azul Celeste Clássico da Steam (Links, seleções e destaques de cabeçalho) -->
        <SolidColorBrush x:Key="BrushAccent" Color="#66C0F4" />
        <SolidColorBrush x:Key="BrushAccentHover" Color="#8FD4FF" />
        <SolidColorBrush x:Key="BrushAccentActive" Color="#1999FF" />

        <!-- Verde Oficial Steam ("Jogar", "Instalar", "Ações Primárias") -->
        <SolidColorBrush x:Key="BrushSteamGreen" Color="#5C7E10" />
        <SolidColorBrush x:Key="BrushSteamGreenHover" Color="#6FA014" />
        <SolidColorBrush x:Key="BrushSteamGreenActive" Color="#4B660D" />
        <SolidColorBrush x:Key="BrushSteamGreenText" Color="#D2E885" />

        <!-- Tipografia Steam (Branco Puro para títulos, C6D4DF para subtítulos, 8F98A0 para descrições) -->
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#C6D4DF" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="#8F98A0" />

        <!-- Estados e Semântica -->
        <SolidColorBrush x:Key="BrushSuccess" Color="#5C7E10" />
        <SolidColorBrush x:Key="BrushSuccessVibrant" Color="#75B022" />
        <SolidColorBrush x:Key="BrushSuccessBg" Color="#1E3314" />
        <SolidColorBrush x:Key="BrushSuccessBorder" Color="#5C7E10" />

        <SolidColorBrush x:Key="BrushWarning" Color="#E5A11A" />
        <SolidColorBrush x:Key="BrushWarningBg" Color="#3D2906" />

        <SolidColorBrush x:Key="BrushError" Color="#C24242" />
        <SolidColorBrush x:Key="BrushErrorBg" Color="#381515" />

        <SolidColorBrush x:Key="BrushGold" Color="#FBBF24" />
        <SolidColorBrush x:Key="BrushGoldBg" Color="#2E1F03" />
        <SolidColorBrush x:Key="BrushGoldBorder" Color="#D97706" />

        <!-- ========================================================================= -->
        <!-- TIPOGRAFIA E ESTILOS PADRÃO                                               -->
        <!-- ========================================================================= -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, -apple-system, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        </Style>

        <!-- ========================================================================= -->
        <!-- ESTILO DE BOTÃO PRIMÁRIO (VERDE CLÁSSICO STEAM DE AÇÃO)                   -->
        <!-- ========================================================================= -->
        <Style x:Key="ButtonPrimaryStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{StaticResource BrushSteamGreen}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#6FA014" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushSteamGreenHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#86C218" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushSteamGreenActive}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B660D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#253044" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#2E3C54" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================================= -->
        <!-- ESTILO DE BOTÃO AZUL STEAM (DESTAQUE / OPERAÇÕES PRINCIPAIS)              -->
        <!-- ========================================================================= -->
        <Style x:Key="ButtonAccentStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#1A9FFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#47B5FF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#66C0F4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F80D4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#253044" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================================= -->
        <!-- ESTILO DE BOTÃO SECUNDÁRIO (FUNDO AZUL-MARINHO STEAM, BORDA FINA)        -->
        <!-- ========================================================================= -->
        <Style x:Key="ButtonSecondaryStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="Background" Value="#212E3D" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A3D52" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushBorderLight}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#172230" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================================= -->
        <!-- ESTILO DE TEXTBOX (FUNDO ESCURO NÍTIDO ESTILO STEAM, TEXTO BRANCO)       -->
        <!-- ========================================================================= -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#121A24" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource BrushAccentActive}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushBorderLight}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                <Setter TargetName="border" Property="Background" Value="#162230" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================================= -->
        <!-- ESTILO DE CARD/PAINEL (DELIMITAÇÃO LIMPA ESTILO STEAM)                   -->
        <!-- ========================================================================= -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- ========================================================================= -->
        <!-- ESTILO DE PROGRESSBAR STEAM                                               -->
        <!-- ========================================================================= -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#101822" />
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================================= -->
        <!-- ESTILO DE CHECKBOX                                                        -->
        <!-- ========================================================================= -->
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0,0,0" />
        </Style>

        <!-- ========================================================================= -->
        <!-- COMBOBOX ESTILO STEAM                                                     -->
        <!-- ========================================================================= -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 5 5 L 10 0 Z"
                          Fill="{StaticResource BrushAccent}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                    <Setter TargetName="border" Property="Background" Value="#25354A" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#273C54" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1A9FFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#1B2838" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />

                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,36,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="13" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide"
                                   Focusable="False">
                                <Border x:Name="dropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#172230"
                                        BorderBrush="{StaticResource BrushAccent}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="4"
                                        Margin="0,4,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================================= -->
        <!-- TABELAS (DATAGRID) ESTILO BIBLIOTECA DA STEAM                             -->
        <!-- ========================================================================= -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowBackground" Value="#17202D" />
            <Setter Property="AlternatingRowBackground" Value="#1B2838" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#131B26" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="36" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#23354C" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#264366" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
